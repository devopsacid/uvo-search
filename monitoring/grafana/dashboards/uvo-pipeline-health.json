    {
      "type": "timeseries",
      "title": "Last success age",
      "description": "Seconds since each worker last completed a batch/cycle successfully. Extractors poll hourly (TED every 6 h), so staying under ~3 h (TED 18 h) is healthy.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (uvo_worker_last_success_timestamp_seconds{component=~\"$component\"} > 0)",
          "legendFormat": "{{component}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
