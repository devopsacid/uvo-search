{
  "uid": "uvo-api-performance",
  "title": "UVO \u00b7 API & search performance",
  "description": "Is the API fast and healthy? Traffic, errors, latency, readiness, cache effectiveness.",
  "tags": [
    "uvo",
    "api"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "UVO dashboards",
      "type": "dashboards",
      "tags": [
        "uvo"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Alert runbook",
      "type": "link",
      "url": "https://github.com/devopsacid/uvo-search/blob/main/monitoring/README.md#alerts",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(uvo_api_http_requests_total, route)",
          "refId": "var-route",
          "qryType": 1
        },
        "definition": "label_values(uvo_api_http_requests_total, route)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      },
      {
        "name": "cache",
        "label": "Cache",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(uvo_cache_requests_total, cache)",
          "refId": "var-cache",
          "qryType": 1
        },
        "definition": "label_values(uvo_cache_requests_total, cache)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1 \u00b7 Is the API healthy right now?",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "API ready",
      "description": "uvo_ready for the API (Mongo ping + Atlas Search indexes). NOT READY returns 503 on /readyz.",
      "targets": [
        {
          "refId": "A",
          "expr": "min(uvo_ready{service=\"uvo-api\"})",
          "legendFormat": "api",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
