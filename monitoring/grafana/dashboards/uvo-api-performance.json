    {
      "type": "stat",
      "title": "5xx ratio (10m)",
      "description": "Share of requests answered with 5xx. Alert fires above 5% with enough traffic.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(uvo_api_http_requests_total{status=~\"5..\", route=~\"$route\"}[10m])) / sum(rate(uvo_api_http_requests_total{route=~\"$route\"}[10m])) or vector(0)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
