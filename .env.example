# Optional -- data sources
EKOSYSTEM_BASE_URL=https://datahub.ekosystem.slovensko.digital
EKOSYSTEM_API_TOKEN=

# Optional -- networking
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
API_MCP_SERVER_URL=http://localhost:8000/mcp
API_PORT=8001

# API — MongoDB connection (for ingestion dashboard). REQUIRED — no default.
API_MONGODB_URI=mongodb://uvo:CHANGEME-SET-A-REAL-PASSWORD@mongo:27017
API_MONGODB_DATABASE=uvo_search

# Optional -- caching
CACHE_TTL_SEARCH=300
CACHE_TTL_ENTITY=3600
CACHE_TTL_DETAIL=1800

# Optional -- general
REQUEST_TIMEOUT=30.0
LOG_LEVEL=INFO

# MongoDB — REQUIRED, no defaults. Generate with: openssl rand -base64 36
MONGO_PASSWORD=CHANGEME-SET-A-REAL-PASSWORD
MONGODB_URI=mongodb://uvo:CHANGEME-SET-A-REAL-PASSWORD@mongo:27017

# Neo4j — REQUIRED, no default. Generate with: openssl rand -base64 36
NEO4J_PASSWORD=CHANGEME-SET-A-REAL-PASSWORD
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Pipeline behaviour
PIPELINE_MODE=recent        # recent | historical
RECENT_DAYS=365
HISTORICAL_FROM_YEAR=2014

# Redis (streams, pub-sub, ITMS cache, distributed locks)
REDIS_URL=redis://redis:6379/0
# Redis AUTH — REQUIRED. Generate with: openssl rand -base64 36
REDIS_PASSWORD=changeme-generate-with-openssl-rand
# ApiSettings uses env_prefix "API_", so it cannot see REDIS_PASSWORD above.
# Set this to the SAME value, or the /v1 rate limiter fails closed on every
# request. (docker-compose maps it for you; this is for running the API natively.)
API_REDIS_PASSWORD=changeme-generate-with-openssl-rand

# Per-source extractor cadence (seconds)
VESTNIK_INTERVAL_SECONDS=3600
CRZ_INTERVAL_SECONDS=3600
TED_INTERVAL_SECONDS=21600
ITMS_INTERVAL_SECONDS=3600

# Per-source extraction mode
VESTNIK_MODE=recent
CRZ_MODE=recent
TED_MODE=recent
ITMS_MODE=recent

# Cross-source dedup worker
DEDUP_INTERVAL_SECONDS=3600
DEDUP_DEBOUNCE_SECONDS=5
DEDUP_WINDOW_DAYS=30

# ITMS cache (memory or redis)
ITMS_CACHE_BACKEND=redis
ITMS_CACHE_TTL_SECONDS=604800

# Ingestor consumer
INGESTOR_BATCH_SIZE=100
STREAM_MAXLEN_APPROX=100000

# Bearer token for /api/dashboard/{ingestion,ingestion-log,worker-status}.
# Generate with: openssl rand -hex 32. Unset disables those endpoints.
API_OPS_TOKEN=
